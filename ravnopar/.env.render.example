# =============================================================================
# Ravnopar — Render Environment (.env format)
# Backend varijable → ravnopar-backend
# Frontend varijable → ravnopar
# =============================================================================

# --- ravnopar-backend ---

# SMTP (Brevo / SendGrid / Gmail app password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=tvoj-smtp-korisnik
SMTP_PASS=tvoja-smtp-lozinka

# Adresa s koje stižu kodovi (registracija, reset lozinke)
MAIL_FROM=Ravnopar <noreply@tvoja-domena.hr>

# Email za admin obavijesti o prijavama korisnika
ADMIN_NOTIFY_EMAIL=admin@tvoja-domena.hr

# Javni URL frontenda (CORS, linkovi u emailovima, pozivnice, Stripe redirect)
FRONTEND_BASE_URL=https://ravnopar.oriph.io
# Dodatni frontend origin-i (zarezom) — npr. stari Render URL
CORS_ALLOWED_ORIGINS=https://ravnopar.onrender.com

# --- ravnopar (static frontend) ---

# Kontakt email — ista adresa kao MAIL_FROM (kodovi, reset lozinke)
VITE_CONTACT_EMAIL=ravnopar@oriph.io

# Donacije — ostavi IBAN prazan dok nemaš pravi broj (placeholder se ne prikazuje)
VITE_DONATE_IBAN=
VITE_DONATE_RECIPIENT=
