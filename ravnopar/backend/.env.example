PORT=4200
NODE_ENV=development

# MySQL (Hostinger VPS / lokalno)
DATABASE_URL="mysql://ravnopar:pass@localhost:3306/ravnopar"
JWT_SECRET="change-me-please-min-32-characters"
FRONTEND_BASE_URL="https://ravnopar.com"
# Produkcija: glavni domen + dodatni origin-i zarezom (npr. https://ravnopar.onrender.com)
CORS_ALLOWED_ORIGINS=
FIRST_USER_IS_ADMIN=true
DAILY_CONTACT_LIMIT=30

# Email — lokalno bez SMTP-a kodovi idu u konzolu
# Hostinger: port 587 (STARTTLS) — ne postavljaj SMTP_SECURE ili =false
# Hostinger alt: port 465 — SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ravnopar <noreply@example.com>
MAIL_FROM=Ravnopar <noreply@localhost>
ADMIN_NOTIFY_EMAIL=

# Premium — isključeno
PLANS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anti-bot — prazno = honeypot
TURNSTILE_SECRET_KEY=

# Umami (admin /admin analitika) — self-host npr. https://analytics.ravnopar.com
UMAMI_BASE_URL=https://analytics.ravnopar.com
UMAMI_WEBSITE_ID=
# Self-host: login token istječe — koristi UMAMI_USERNAME + UMAMI_PASSWORD (preporučeno)
UMAMI_USERNAME=admin
UMAMI_PASSWORD=
UMAMI_API_TOKEN=
UMAMI_SHARE_URL=
UMAMI_SITE_LABEL=ravnopar.com

# Tvoj IP(ovi) za isključenje iz Umami — sync s deploy/umami/.env (IGNORE_IP)
# ANALYTICS_IGNORE_IPS=89.123.45.67

# Legacy Plausible (ne koristi se — ostavljeno prazno)
# PLAUSIBLE_SITE=
# PLAUSIBLE_API_KEY=
# PLAUSIBLE_SHARED_DASHBOARD_URL=

# Fotografije ostaju u bazi (base64). S3 nije potreban.
# Video upload na lokalni disk (VPS)
# UPLOAD_DIR=/var/www/ravnopar/uploads

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@ravnopar.com
