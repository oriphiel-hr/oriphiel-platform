{
  "name": "ravnopar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "migrate:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:reset": "cross-env ALLOW_SEED_RESET=true node prisma/reset-seed.js && node prisma/seed.js",
    "admin:create": "node scripts/create-admin.js",
    "admin:check": "node scripts/check-user.js",
    "test": "node --test test/smoke.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "prisma": "^6.6.0",
    "stripe": "^17.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
