# Oriphiel (oriphiel.hr) - mario.vitt@oriphiel.hr
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=mario.vitt@oriphiel.hr
IMAP_PASSWORD='PROMijeni_ME'
ACCOUNT_EMAIL=mario.vitt@oriphiel.hr
MAILBOX=INBOX
LIMIT=0
ONLY_UNSEEN=0
DRY_RUN=0
RESET_BEFORE=0
RESET_ACCOUNTS=0
SAVE_ATTACHMENTS=1
ATTACH_DIR=/var/lib/oriphiel/attachments
MAX_ATTACH_BYTES=26214400
# Batch (svakih N poruka: gc + kratka pauza)
BATCH_SIZE=50
BATCH_SLEEP_SEC=1
# Ollama AI polja u messages
RUN_AI=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# IMAP Seen flag — default 0. Ne znaci da SI TI procitao mail.
MARK_AS_SEEN=0
STATUS_FILE=/tmp/oriphiel-imap-backfill-mario.vitt.json
PROGRESS_EVERY=10
